## Data import

This section imports all CSV files whose names start with "an" from the
group14_data folder. It combines them into a long-format table, corrects
confirmed field-name inconsistencies, and reshapes the data into a wide table
with one row per source file.

```{r}
library(tidyr)

# Use the current working directory
folder <- "/Users/lihang/Documents/DCDM/group14_data"

# Find all CSV files whose names start with "an"
files <- list.files(
  folder,
  pattern = "^an.*\\.csv$",
  full.names = TRUE
)

if (length(files) == 0) {
  stop("No an*.csv files were found. Please check the working directory.")
}

# Import one file and standardise known field-name variations
read_one <- function(f) {
  x <- read.csv(
    f,
    header = FALSE,
    col.names = c("variable", "value"),
    stringsAsFactors = FALSE,
    check.names = FALSE,
    colClasses = "character",
    na.strings = character(),
    fill = TRUE,
    quote = "\""
  )
  
  if (ncol(x) != 2) {
    stop(paste("The file was not read as two columns:", basename(f)))
  }
  
  x$variable <- trimws(x$variable)
  x$value <- trimws(x$value)
  
  # Fix known cases where a field name and value were joined together
  missing_value <- is.na(x$value) | x$value == ""
  
  i <- grepl('^lacz_skin"?expression$', x$variable) & missing_value
  x$variable[i] <- "lacz_skin"
  x$value[i] <- "expression"
  
  i <- grepl('^lacz_colon"?No data$', x$variable) & missing_value
  x$variable[i] <- "lacz_colon"
  x$value[i] <- "No data"
  
  # Remove an accidental trailing quote from field names
  x$variable <- sub('"$', "", x$variable)
  
  # Standardise confirmed spelling variations
  name_map <- c(
    "mouselife_stage" = "mouse_life_stage",
    "Allele_symbol"   = "allele_symbol",
    "laczHeart"       = "lacz_heart"
  )
  
  i <- x$variable %in% names(name_map)
  x$variable[i] <- unname(name_map[x$variable[i]])
  
  # Remove rows with a missing or blank field name
  keep <- !is.na(x$variable) & x$variable != ""
  x <- x[keep, ]
  
  # Stop if a field name occurs more than once in a file
  if (anyDuplicated(x$variable)) {
    stop(paste("Duplicate field names found in:", basename(f)))
  }
  
  # Record the source file for each row
  x$source_file <- basename(f)
  x
}

# Import and combine all files in long format
data_fixed <- do.call(rbind, lapply(files, read_one))
rownames(data_fixed) <- NULL

# Check that each file has only one record for each field
if (anyDuplicated(data_fixed[c("source_file", "variable")])) {
  stop("A field occurs more than once in the same file. Please inspect the source files.")
}

# Convert to wide format: one row per file and one column per field
wide_data <- pivot_wider(
  data_fixed,
  id_cols = source_file,
  names_from = variable,
  values_from = value
)

# View and inspect the result
View(wide_data)
dim(wide_data)
names(wide_data)
```
## Data cleaning: column names and p-values

This section creates a working copy of the imported data, renames two columns
to match the SOP, converts p-values to numeric values, and replaces p-values
outside the valid range of 0 to 1 with NA.

```{r}

# Create a working copy of the original data
clean_wide_data <- wide_data

# Rename columns to match the SOP
names(clean_wide_data)[names(clean_wide_data) == "p_value"] <- "pvalue"
names(clean_wide_data)[names(clean_wide_data) == "parameter_stable_id"] <- "parameter_id"

# Convert pvalue to numeric
clean_wide_data$pvalue <- suppressWarnings(
  as.numeric(as.character(clean_wide_data$pvalue))
)

# Count p-values outside the valid range [0, 1]
invalid_pvalue <- !is.na(clean_wide_data$pvalue) &
  (clean_wide_data$pvalue < 0 | clean_wide_data$pvalue > 1)

invalid_pvalues_before <- sum(invalid_pvalue)

# Replace p-values below 0 or above 1 with NA
clean_wide_data$pvalue[invalid_pvalue] <- NA

# Summarise the p-value cleaning
data.frame(
  rows_before = nrow(wide_data),
  rows_after = nrow(clean_wide_data),
  invalid_pvalues_replaced_with_NA = invalid_pvalues_before
)
```


