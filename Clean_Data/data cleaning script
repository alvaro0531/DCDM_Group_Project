## Cleaning `mouse_life_stage`

This section removes symbols other than letters, numbers, spaces, and periods from `mouse_life_stage`. It preserves decimal points in values such as `E12.5` and standardises equivalent spellings of `Early adult`.
```{r}
#mouse_life_stage
# Save the original values for comparison
mouse_life_stage_before <- clean_wide_data$mouse_life_stage

# Remove stray symbols, keeping letters, numbers, spaces, and periods
clean_wide_data$mouse_life_stage <- gsub(
  "[^[:alnum:]. ]",
  "",
  trimws(as.character(clean_wide_data$mouse_life_stage))
)

# Tidy repeated spaces
clean_wide_data$mouse_life_stage <- gsub(
  "\\s+",
  " ",
  clean_wide_data$mouse_life_stage
)

# Standardise the spelling and capitalisation of "Early adult"
is_early_adult <- !is.na(clean_wide_data$mouse_life_stage) &
  tolower(clean_wide_data$mouse_life_stage) == "early adult"

clean_wide_data$mouse_life_stage[is_early_adult] <- "Early adult"

# Show values that changed
mouse_life_stage_changes <- data.frame(
  source_file = clean_wide_data$source_file,
  before = mouse_life_stage_before,
  after = clean_wide_data$mouse_life_stage
)

mouse_life_stage_changes <- mouse_life_stage_changes[
  !is.na(mouse_life_stage_changes$before) &
    mouse_life_stage_changes$before != mouse_life_stage_changes$after,
]

View(mouse_life_stage_changes)
```

## Cleaning the lacZ tissue columns

This section processes all columns beginning with `lacz_`. It removes punctuation, converts values to lowercase, and replaces repeated spaces with a single space. Changed values are recorded for review.
```{r}
# Select all lacZ tissue columns
lacz_cols <- grep("^lacz_", names(clean_wide_data), value = TRUE)

# Save the original values for comparison
lacz_before <- clean_wide_data[lacz_cols]

# Remove punctuation, standardise case, and tidy spaces
clean_wide_data[lacz_cols] <- lapply(clean_wide_data[lacz_cols], function(x) {
  x <- as.character(x)
  x <- gsub("[^[:alnum:] ]", "", x)
  x <- tolower(trimws(x))
  gsub("\\s+", " ", x)
})

# Create a before-and-after table for changed values
lacz_changes <- data.frame(
  source_file = rep(clean_wide_data$source_file, times = length(lacz_cols)),
  column = rep(lacz_cols, each = nrow(clean_wide_data)),
  before = unlist(lacz_before, use.names = FALSE),
  after = unlist(clean_wide_data[lacz_cols], use.names = FALSE)
)

lacz_changes <- lacz_changes[
  !is.na(lacz_changes$before) &
    lacz_changes$before != lacz_changes$after,
]

View(lacz_changes)
```



## Cleaning duplicate records

This section removes fully identical rows from `clean_wide_data`, ignoring
`source_file`, while keeping one copy of each record. It then identifies
`analysis_id` values that still occur more than once and stores their rows in
`duplicate_id_rows` for manual review. These records are not automatically
removed from the main table.

```{r}
# Remove fully identical rows from the main table, ignoring source_file
data_columns <- setdiff(names(clean_wide_data), "source_file")
identical_rows <- duplicated(clean_wide_data[data_columns])

clean_wide_data <- clean_wide_data[
  !identical_rows,
  ,
  drop = FALSE
]

# Find analysis_id values that still occur more than once
id_counts <- table(clean_wide_data$analysis_id)
repeated_ids <- names(id_counts[id_counts > 1])

# Keep all rows with repeated analysis_id for manual review
duplicate_id_rows <- clean_wide_data[
  !is.na(clean_wide_data$analysis_id) &
    clean_wide_data$analysis_id %in% repeated_ids,
  ,
  drop = FALSE
]

# Check that every ID in the review table occurs at least twice
table(duplicate_id_rows$analysis_id)

View(duplicate_id_rows)
```




